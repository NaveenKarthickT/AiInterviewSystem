# ==============================================================================
# AI Interview System - Environment Configuration
# ==============================================================================

PROJECT_NAME="AI Adaptive Interview & Resume Optimization System"
API_V1_STR="/api/v1"
SECRET_KEY="replace-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite fallback)
# For local SQLite development:
DATABASE_URL="sqlite:///./interview_system.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://user:password@localhost:5432/interview_db"

# LLM Provider Configuration
# Supported providers: gemini, openai, groq, ollama
DEFAULT_LLM_PROVIDER="gemini"

# LLM API Keys
GEMINI_API_KEY=""
OPENAI_API_KEY=""
GROQ_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# Upload and Storage Paths
UPLOAD_DIR="./uploads"
EXPORT_DIR="./exports"

# CORS Allowed Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]
